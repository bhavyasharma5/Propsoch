# Server
SERVER_PORT=3000

# JWT - set a long random string here
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRY=7d

# SQLite DB path (relative to project root)
DB_PATH=./database.sqlite

# Email config for monthly reports (using Gmail as example)
# For testing, you can use Ethereal: https://ethereal.email/
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_pass
SMTP_FROM=splitwise-mvp@example.com
